# Copy to backend/.env (gitignored) and fill in. Never commit the real file.

# Vercel AI Gateway key: pays for question routing (baseten/mammoth-1) and slot filling (openai/gpt-5-nano).
VERCEL_AI_GATEWAY_kEY=your-gateway-key-here

# Optional overrides
# ASK_ROUTER_MODEL=baseten/mammoth-1
# ASK_EXTRACT_MODEL=openai/gpt-5-nano
# ASK_RELATED_MIN=0.5
# ASK_CATEGORY_MIN=0.6
# Browser origins allowed to call the API (comma-separated)
# ASK_ALLOWED_ORIGINS=http://localhost:3000
# Regex for per-deploy origins such as Vercel previews
# ASK_ALLOWED_ORIGIN_REGEX=https://iaci(-[a-z0-9-]+-ramsaideeps-projects)?\.vercel\.app
