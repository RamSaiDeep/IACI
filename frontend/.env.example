# Ask the Index. No LLM key is ever stored on the server: users paste their own
# key in the browser and it is sent per request. Nothing here is a secret.

# Default model offered in the Ask page (claude-sonnet-5-5 | claude-haiku-5-5 | claude-opus-5-5 | claude-fable-5-2)
ASK_DEFAULT_MODEL=claude-sonnet-5-5

# Set to 1 to show the "Demo mode (no key)" switch on the Ask page in a production build.
# It is always available when running `npm run dev`.
ASK_ALLOW_MOCK=0
